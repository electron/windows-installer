{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "node": true,
    "es2023": true
  },
  "rules": {
    "no-var": "error",
    "eqeqeq": "error",
    "prefer-const": [
      "error",
      {
        "destructuring": "all"
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "vars": "all",
        "args": "after-used",
        "ignoreRestSiblings": true
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-require-imports": "off"
  },
  "ignorePatterns": ["lib/", "node_modules/", "vendor/", "spec/fixtures/"]
}
