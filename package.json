{
  "name": "electron-winstaller",
  "version": "0.0.0-development",
  "description": "Module to generate Windows installers for Electron apps",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electron/windows-installer.git"
  },
  "files": [
    "lib",
    "resources",
    "script",
    "template.nuspectemplate",
    "vendor",
    "!vendor/7z.dll",
    "!vendor/7z.exe"
  ],
  "type": "module",
  "scripts": {
    "install": "node ./script/select-7z-arch.js",
    "build": "tsc",
    "docs": "typedoc",
    "prepare": "npm run build",
    "lint": "eslint --ext .ts src spec",
    "ava": "ava --timeout=60s",
    "test": "npm run lint && npm run ava",
    "tdd": "ava --watch"
  },
  "dependencies": {
    "@electron/asar": "^4.0.0",
    "@electron/windows-sign": "^2.1.0",
    "obug": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "ava": "^6.4.1",
    "eslint": "^8.49.0",
    "eslint-plugin-ava": "^14.0.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "files": [
      "spec/*.ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ]
  }
}
