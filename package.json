{
  "name": "electron-winstaller",
  "version": "0.0.0-development",
  "description": "Module to generate Windows installers for Electron apps",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electron/windows-installer.git"
  },
  "files": [
    "lib",
    "resources",
    "script",
    "template.nuspectemplate",
    "vendor",
    "!vendor/7z.dll",
    "!vendor/7z.exe"
  ],
  "type": "module",
  "scripts": {
    "install": "node ./script/select-7z-arch.js",
    "build": "tsc",
    "docs": "typedoc",
    "prepare": "npm run build",
    "lint": "eslint",
    "unit": "tsx --test --test-timeout=120000 \"spec/*-spec.ts\"",
    "test": "npm run lint && npm run unit",
    "tdd": "tsx --test --watch \"spec/*-spec.ts\""
  },
  "dependencies": {
    "@electron/asar": "^4.0.0",
    "@electron/windows-sign": "^2.1.0",
    "obug": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@stylistic/eslint-plugin": "^5",
    "@types/node": "^22",
    "eslint": "^10",
    "globals": "^17",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
