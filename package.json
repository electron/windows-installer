{
  "name": "electron-winstaller",
  "version": "0.0.0-development",
  "description": "Module to generate Windows installers for Electron apps",
  "type": "module",
  "exports": "./lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electron/windows-installer.git"
  },
  "files": [
    "lib",
    "resources",
    "script",
    "template.nuspectemplate",
    "vendor",
    "!vendor/7z.dll",
    "!vendor/7z.exe"
  ],
  "scripts": {
    "install": "node ./script/select-7z-arch.js",
    "build": "tsc",
    "docs": "typedoc",
    "prepare": "npm run build",
    "lint": "oxlint src spec",
    "lint:fix": "oxlint --fix src spec",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --import jiti/register --test --test-timeout=60000 \"spec/*-spec.ts\"",
    "tdd": "node --import jiti/register --test --watch \"spec/*-spec.ts\""
  },
  "dependencies": {
    "@electron/asar": "^3.2.1",
    "@electron/windows-sign": "^2.1.0",
    "debug": "^4.1.1",
    "fs-extra": "^7.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^5.0.5",
    "@types/lodash": "^4.17.0",
    "@types/node": "~22.10.7",
    "jiti": "2.7.0",
    "oxlint": "1.81.0",
    "typedoc": "0.25.13",
    "typescript": "~5.4.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
